{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compound Intelligence scoped practice record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "rule",
    "scope",
    "trigger",
    "action",
    "rationale",
    "source",
    "observations",
    "limits",
    "status",
    "user_approved",
    "updated",
    "review_trigger"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "preference",
        "principle",
        "experiment",
        "local_pattern"
      ]
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "chapter"
      ],
      "properties": {
        "basis": {
          "type": "string"
        },
        "chapter": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 21
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "provisional",
        "endorsed",
        "supported_locally",
        "retired"
      ]
    },
    "user_approved": {
      "type": "boolean"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "review_trigger": {
      "type": "string"
    }
  }
}
